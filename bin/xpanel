#!/usr/bin/env bash
set -euo pipefail

CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${XPANEL_ROOT:-}"
COMMAND="help"
ARGS=()
ORIGINAL_ARGS=("$@")

for ARG in "$@"; do
  case "$ARG" in
    --root=*)
      ROOT="${ARG#--root=}"
      ;;
    *)
      if [[ "$COMMAND" == "help" ]]; then
        COMMAND="$ARG"
      else
        ARGS+=("$ARG")
      fi
      ;;
  esac
done

is_product_root() {
  [[ -f "$1/xpanel" || -f "$1/scripts/xpanel-system.sh" || -f "$1/artisan" || -f "$1/go.mod" ]]
}

if [[ -z "$ROOT" ]]; then
  current_root="$(pwd)"
  if is_product_root "$current_root"; then
    ROOT="$current_root"
  elif [[ -n "${XPANEL_DEFAULT_ROOT:-}" ]] && is_product_root "$XPANEL_DEFAULT_ROOT"; then
    ROOT="$XPANEL_DEFAULT_ROOT"
  else
    for candidate in /opt/xpanel-host /opt/xpanel-core /opt/xpanel-pod; do
      if is_product_root "$candidate"; then
        ROOT="$candidate"
        break
      fi
    done
  fi
fi
ROOT="${ROOT:-$(pwd)}"
ROOT="$(cd "$ROOT" 2>/dev/null && pwd || printf '%s' "$ROOT")"

case "$COMMAND" in
  update|uninstall|serve)
    if [[ "$(uname -s)" == "Linux" && "$(id -u)" != "0" ]]; then
      command -v sudo >/dev/null 2>&1 || { echo "sudo is required for $COMMAND." >&2; exit 1; }
      exec sudo -- "$0" "${ORIGINAL_ARGS[@]}"
    fi
    ;;
esac

export XPANEL_CLI_DIR="$CLI_DIR"
export XPANEL_ROOT="$ROOT"

# shellcheck source=/dev/null
source "$CLI_DIR/lib/context.sh"

COMMAND_FILE="$CLI_DIR/commands/$COMMAND.sh"

case "$COMMAND" in
  -h|--help)
    COMMAND_FILE="$CLI_DIR/commands/help.sh"
    ;;
esac

if [[ ! -f "$COMMAND_FILE" ]]; then
  echo "$(xpanel_t unknown_command command="$COMMAND")" >&2
  echo
  "$CLI_DIR/commands/help.sh"
  exit 1
fi

exec "$COMMAND_FILE" "${ARGS[@]}"
